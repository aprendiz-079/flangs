function get_files_names
{
	# get_files_names "asdasd asdsd asd asddasd"
	#s='asdasd asdsd asd asddasd'
	# and not
	#s='asdasd'
	local s=$1 # so the ' is unless
	[[ "$s" == "" ]] && return 0

	s_qtd=$(echo $s | wc -w)
	s="$(echo $s | sed 's/ /\n/g')"

	local -n _ret=$2
	for((i=1; i<=$s_qtd; i++))
	do
		_ret=($(echo "$s" | awk NR==$i))
	done
	return 0
}

