function format_package_path
{
	local target_dir="$1"

	# /path/to/ to path/to if necessary
	[[ ${target_dir:0:1} == '/' ]] && \
	target_dir="${target_dir:1}"

	[[ ${target_dir:$((${#s}-1)):1} == '/' ]] && \
	target_dir="${target_dir:$((${#target_dir}-1)):1}"

	target_dir=$(echo -e "$target_dir" | sed 's/\//\./')

	printf "$s" $target_dir
}

