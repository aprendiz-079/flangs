putc(), fputc():

Write a character to STREAM.

extern int fputc (int __c, FILE *__stream) __nonnull ((2));

   These functions are possible cancellation points and therefore not
   marked with __THROW.  */

extern int putc (int __c, FILE *__stream) __nonnull ((2));
